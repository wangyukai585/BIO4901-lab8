# Run from project8/: snakemake -s scripts/Snakefile --cores 1 --config subset=True
from pathlib import Path
import sys
ROOT = Path(workflow.basedir).parent
workdir: str(ROOT)
SMOKE = str(config.get('subset','True')).lower() in ('true','1','yes')
OUT = str(config.get('output_dir','results' if SMOKE else 'results/full_run'))
EMB = str(config.get('embedding_dir','data/embeddings' if SMOKE else 'data/embeddings_full'))
PYTHON = sys.executable
COMMON = '--subset_size 200 --eval_size 40 --max_length 128' if SMOKE else '--max_length 512'
COMMON += ' --device ' + str(config.get('device','auto'))
EPOCHS = int(config.get('epochs',2 if SMOKE else 10))
FT = '--batch_size 1 --effective_batch_size 1 --max_steps 1 --epochs 1' if SMOKE else f'--batch_size 4 --effective_batch_size 16 --epochs {EPOCHS}'

rule all:
    input:
        f'{OUT}/metrics_table.csv', f'{OUT}/bootstrap_ci.csv',
        expand(f'{OUT}/images/{{name}}.pdf',name=['fig1_parameter_efficiency','fig2_performance_cost','fig3_calibration','fig4_confusion_matrices','fig5_embedding_pca','fig6_workflow','fig7_training_curves'])

rule data:
    output: 'data/raw/deeploc_data.fasta','results/qc/summary.json','results/images/fig0_data_qc.pdf'
    shell: '{PYTHON} codes/01_download_data.py'

rule frozen:
    input: 'data/raw/deeploc_data.fasta'
    output: f'{OUT}/frozen/predictions.csv', f'{OUT}/frozen/robust_predictions.csv',f'{OUT}/frozen/run.json', f'{EMB}/embeddings.npz',f'{EMB}/metadata.json'
    shell: '{PYTHON} codes/02_extract_embeddings.py {COMMON} --batch_size 4 --embedding_dir {EMB} --output_dir {OUT}/frozen'

rule linear:
    input: f'{EMB}/embeddings.npz',f'{EMB}/metadata.json'
    output: f'{OUT}/linear/predictions.csv',f'{OUT}/linear/robust_predictions.csv',f'{OUT}/linear/run.json',f'{OUT}/linear/history.csv'
    shell: '{PYTHON} codes/03_train_linear_probe.py {COMMON} --epochs {EPOCHS} --batch_size 16 --embedding_dir {EMB} --output_dir {OUT}/linear'

rule lora:
    input: 'data/raw/deeploc_data.fasta'
    output: f'{OUT}/lora/predictions.csv',f'{OUT}/lora/robust_predictions.csv',f'{OUT}/lora/run.json',f'{OUT}/lora/history.csv'
    resources: gpu=1
    shell: '{PYTHON} codes/04_train_lora.py {COMMON} --epochs {EPOCHS} --batch_size 4 --effective_batch_size 16 --output_dir {OUT}/lora'

rule full:
    input: 'data/raw/deeploc_data.fasta'
    output: f'{OUT}/full/predictions.csv',f'{OUT}/full/robust_predictions.csv',f'{OUT}/full/run.json',f'{OUT}/full/history.csv'
    resources: gpu=1
    shell: '{PYTHON} codes/05_train_full_ft.py {COMMON} {FT} --output_dir {OUT}/full'

rule evaluate:
    input:
        expand(f'{OUT}/{{stage}}/predictions.csv',stage=['frozen','linear','lora','full']),
        expand(f'{OUT}/{{stage}}/robust_predictions.csv',stage=['frozen','linear','lora','full']),
        expand(f'{OUT}/{{stage}}/run.json',stage=['frozen','linear','lora','full'])
    output: f'{OUT}/metrics_table.csv',f'{OUT}/bootstrap_ci.csv'
    shell: '{PYTHON} codes/06_evaluate_and_bootstrap.py --output_dir {OUT} --n_bootstrap 1000'

rule figures:
    input: f'{OUT}/metrics_table.csv',f'{OUT}/bootstrap_ci.csv',f'{EMB}/embeddings.npz',expand(f'{OUT}/{{stage}}/history.csv',stage=['linear','lora','full'])
    output: expand(f'{OUT}/images/{{name}}.pdf',name=['fig1_parameter_efficiency','fig2_performance_cost','fig3_calibration','fig4_confusion_matrices','fig5_embedding_pca','fig6_workflow','fig7_training_curves'])
    shell: '{PYTHON} codes/07_make_figures.py --output_dir {OUT} --embedding_dir {EMB}'
